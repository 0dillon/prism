# Copy to .env.local and fill in. Never commit real values.
# Required variables are validated at startup by src/lib/env.ts.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# LLM gateway (required). LLM_PROVIDER is one of: anthropic | openai
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_HEAVY=
LLM_MODEL_FAST=

# Speech. browser uses the Web Speech APIs and needs no key.
STT_PROVIDER=browser                # browser | <provider>
STT_API_KEY=
TTS_PROVIDER=browser                # browser | <provider>
TTS_API_KEY=

# Payments (Phase 7, test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PLATFORM_FEE_BPS=1500

# Background jobs (Phase 2, P2-20)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability (Phase 8)
SENTRY_DSN=
