# Prism backend configuration. Copy to .env and fill in.
# NEVER commit a filled-in copy. Values here are names and safe defaults only.

# ---- runtime ----------------------------------------------------------------
APP_ENV=development                  # development | test | staging | production
LOG_LEVEL=INFO
SERVICE_NAME=prism-backend

# ---- Supabase ---------------------------------------------------------------
# Server-side only. The NEXT_PUBLIC_ prefixed variants in PRD 7.6 are for the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=            # sb_publishable_... (replaces the legacy anon key)
SUPABASE_SECRET_KEY=                 # sb_secret_...      (replaces SUPABASE_SERVICE_ROLE_KEY)

# ---- JWT verification -------------------------------------------------------
# Left blank, JWKS URL and issuer are derived from SUPABASE_URL.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWT_LEEWAY_SECONDS=5
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
SUPABASE_JWKS_REFRESH_COOLDOWN_SECONDS=30
SUPABASE_JWKS_TIMEOUT_SECONDS=5
# Set ONLY while migrating a project off legacy HS256 signing. Remove afterwards.
SUPABASE_LEGACY_JWT_SECRET=

# ---- database ---------------------------------------------------------------
# Two roles, deliberately. prism_app is NOINHERIT and must SET ROLE per transaction, so a
# forgotten identity fails loudly instead of silently returning every row. prism_service
# reaches service_role and is restricted to an allowlisted set of modules.
DATABASE_URL_RLS=
DATABASE_URL_PRIVILEGED=
DB_RLS_POOL_MIN_SIZE=2
DB_RLS_POOL_MAX_SIZE=20
DB_PRIVILEGED_POOL_MIN_SIZE=0
DB_PRIVILEGED_POOL_MAX_SIZE=3
DB_STATEMENT_TIMEOUT_MS=5000
DB_DASHBOARD_STATEMENT_TIMEOUT_MS=2000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_USE_TRANSACTION_POOLER=false      # true disables prepared statements (Supavisor port 6543)

# ---- LLM --------------------------------------------------------------------
LLM_PROVIDER=fake                    # openai | fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_HEAVY=                     # extraction and merge
LLM_MODEL_FAST=                      # intents, grading, variants, grounding
LLM_TIMEOUT_HEAVY_SECONDS=120
LLM_TIMEOUT_FAST_SECONDS=20
LLM_MAX_ATTEMPTS=3
LLM_MAX_INFLIGHT_HEAVY=8
LLM_MAX_INFLIGHT_FAST=32

# ---- ingestion --------------------------------------------------------------
INGESTION_MAP_CONCURRENCY=4          # PRD 5.1 step 4
INGESTION_ARTIFACT_INLINE_MAX_BYTES=262144
INGESTION_MAX_DEGRADED_FRACTION=0.20
INGESTION_STAGE_DEADLINE_SECONDS=900
INGESTION_RUNNER=inprocess           # inprocess | durable

# ---- storage ----------------------------------------------------------------
STORAGE_MAX_UPLOAD_BYTES=52428800    # 50 MB, PRD CE-1
STORAGE_SIGNED_URL_TTL_SECONDS=900   # PRD 6.4 caps this at 3600

# ---- speech -----------------------------------------------------------------
STT_PROVIDER=browser                 # browser | openai
STT_API_KEY=
TTS_PROVIDER=browser                 # browser | openai
TTS_API_KEY=
SPEECH_TIMEOUT_SECONDS=15

# ---- limits -----------------------------------------------------------------
RATE_LIMIT_BACKEND=postgres          # postgres | memory | disabled
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BYTES=1048576
REQUEST_ID_MAX_LENGTH=128

# ---- payments (not used by the MVP) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PLATFORM_FEE_BPS=1500

# ---- observability ----------------------------------------------------------
SENTRY_DSN=
